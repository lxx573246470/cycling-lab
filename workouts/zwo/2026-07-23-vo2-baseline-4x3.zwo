    <SteadyState Duration="180" Power="1.08" Cadence="90"/>
    <SteadyState Duration="180" Power="0.50"/>
    <SteadyState Duration="180" Power="1.10" Cadence="90"/>
    <SteadyState Duration="180" Power="0.50"/>
    <SteadyState Duration="180" Power="1.10" Cadence="90"/>
    <SteadyState Duration="180" Power="0.50"/>
    <SteadyState Duration="180" Power="1.12" Cadence="90"/>
    <SteadyState Duration="180" Power="0.50"/>
    <SteadyState Duration="540" Power="0.60" Cadence="85"/>
    <Cooldown Duration="720" PowerLow="0.52" PowerHigh="0.38"/>
  </workout>
</workout_file>
